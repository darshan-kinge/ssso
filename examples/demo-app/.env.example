# ─── SaaS mode (recommended) ───────────────────────────────────────────────
# Tenant auth host: https://{workspace-slug}.{TENANT_DOMAIN_SUFFIX}
# Must match a workspace created in SSSO /workspace/new
NEXT_PUBLIC_AUTH_URL=http://acme.localhost:3000
NEXT_PUBLIC_SSSO_WORKSPACE_SLUG=acme

# ─── Personal / single-host mode ───────────────────────────────────────────
# NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# From SSSO dashboard (/dashboard in SaaS) after registering this demo app
NEXT_PUBLIC_SSSO_CLIENT_ID=oa_your_client_id

# Same as JWT_SECRET in SSSO root .env.local
SSSO_JWT_SECRET=your_jwt_secret_min_32_chars

# OAuth callback — must match registered redirect URL exactly
NEXT_PUBLIC_SSSO_REDIRECT_URI=http://localhost:3001/callback

# Optional — not needed for public + PKCE apps
# SSSO_CLIENT_SECRET=your_client_secret
