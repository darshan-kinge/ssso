# OneAuth server (main app) — default http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# From OneAuth /apps after registering this demo (redirect: http://localhost:3001/callback)
NEXT_PUBLIC_ONEAUTH_CLIENT_ID=oa_your_client_id
ONEAUTH_CLIENT_SECRET=your_client_secret

# Same value as JWT_SECRET in OneAuth .env.local
ONEAUTH_JWT_SECRET=your_jwt_secret_min_32_chars

# This demo app's OAuth callback (must match registered redirect URL exactly)
NEXT_PUBLIC_ONEAUTH_REDIRECT_URI=http://localhost:3001/callback
