# ─── Secrets (required in production) ───────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.example/ssso
JWT_SECRET=generate-a-long-random-string-min-32-chars
REFRESH_PEPPER=another-long-random-string-for-refresh-hashing

# ─── App branding (override ssso.config.ts) ───────────────────────────────
NEXT_PUBLIC_APP_NAME=SSSO
NEXT_PUBLIC_APP_TAGLINE=Simple SSO for your projects
NEXT_PUBLIC_APP_DESCRIPTION=Personal authentication platform
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# ─── URLs ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_URL=http://localhost:3000

# ─── Token & security tuning (optional) ──────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=false

# Phase 6 — rate limit & audit
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_RETENTION_DAYS=90
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_SIGNUP_MAX=5

# Email (Phase 5) — omit for dev console logging
# RESEND_API_KEY=re_...
# EMAIL_FROM=SSSO <onboarding@resend.dev>
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=1

# OAuth (Phase 2)
AUTHORIZATION_CODE_TTL_SECONDS=300
REQUIRE_PKCE_FOR_PUBLIC_CLIENTS=true

# Multi-tenant SaaS (enabled by ssso.config.ts)
DEPLOYMENT_MODE=saas
MULTI_TENANT_ENABLED=true
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
TENANT_DOMAIN_SUFFIX=localhost:3000
# Production landing host (defaults to ssso.in)
# LANDING_DOMAIN=ssso.in
