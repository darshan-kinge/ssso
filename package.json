{
  "name": "oneauth",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/demo-app",
    "examples/open-mode-demo"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:demo": "npm run build:packages && npm run dev -w ssso-demo-app",
    "build": "npm run build:packages && next build",
    "build:packages": "npm run build -w @ssso/core && npm run build -w @ssso/react && npm run build -w @ssso/node",
    "build:demo": "npm run build:packages && npm run build -w ssso-demo-app",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "tsx --test --test-concurrency=1 tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.14",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  }
}
