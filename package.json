{
  "name": "oneauth",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/demo-app"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:demo": "npm run build:packages && npm run dev -w oneauth-demo-app",
    "build": "npm run build:packages && next build",
    "build:packages": "npm run build -w @oneauth/core && npm run build -w @oneauth/react && npm run build -w @oneauth/node",
    "build:demo": "npm run build:packages && npm run build -w oneauth-demo-app",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2"
  }
}
